{
  "name": "sharpurs",
  "version": "0.1.0",
  "description": "PureScript-to-F# (& C#) backend",
  "type": "module",
  "bin": {
    "sharpurs": "bin/sharpurs.js"
  },
  "scripts": {
    "build": "spago build && spago bundle --module Main --platform node --outfile bin/sharpurs.js --bundle-type app",
    "test": "node tests/run.mjs",
    "compare:generation": "node scripts/compare-generation.mjs",
    "test:tools": "node --test tests/tools.mjs",
    "test:cli": "node tests/cli.mjs",
    "test:runtime": "node tests/runtime-apply.mjs",
    "test:ffi-support": "node tests/ffi-support.mjs",
    "test:project": "node tests/project.mjs",
    "test:names": "node tests/names.mjs",
    "test:printer": "node tests/printer.mjs",
    "test:recursion": "node tests/recursion.mjs",
    "test:case-patterns": "node tests/case-patterns.mjs",
    "test:kernel": "node tests/int-kernel.mjs",
    "test:local-kernel": "node tests/local-int-kernel.mjs",
    "test:selection": "node tests/selection.mjs",
    "test:adt-kernel": "node tests/adt-kernel.mjs",
    "test:adt-lowering": "node tests/adt-lowering.mjs",
    "test:adt-interop": "node tests/adt-interop.mjs",
    "test:adt-unary": "node tests/adt-unary.mjs",
    "test:adt-multi": "node tests/adt-multi.mjs",
    "test:int-comparison": "node tests/int-comparison.mjs",
    "test:int-arithmetic": "node tests/int-arithmetic.mjs",
    "test:direct-call": "node tests/direct-call.mjs",
    "test:thunk-kernel": "node tests/thunk-kernel.mjs",
    "test:constructor-typeapp": "node tests/constructor-typeapp.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "purs-backend-es": "^1.4.3"
  },
  "devDependencies": {
    "purescript": "github:0x000000000000000000001/purescript-npm"
  }
}
