#!/usr/bin/env bash

# Test runner for sharpurs
# Compiles and runs PureScript passing tests via .NET / F#

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd) || exit 1
TEST_DIR="$ROOT_DIR/tests"
PASSING_DIR="$TEST_DIR/passing"
RUNNER_DIR="$TEST_DIR/runner"

# Tests to skip (e.g. tests using experimental compiler features not supported by our purs version)
BLACKLIST=(
  # For versions > 0.15
  "DerivingClause.purs"
  "DerivingContravariant.purs"
  "DerivingFunctorFromBi.purs"
  "DerivingFunctorFromPro.purs"
  "DerivingProfunctor.purs"
  # JS-only semantics: dynamic import and initialization-order diagnostics
  "4179.purs"
  # Expects a stack overflow for non-TCO'd mutual recursion. The backend
  # eta-expands these mismatched-arity partial applications and compiles them as
  # tail-recursive loops, so they complete with correct values (ntco1 100000 =
  # 1000009, ntco2/3/4 = 200000). The test itself notes that such an
  # optimisation would invalidate the assertions, and the runner's 1 GiB stack
  # would absorb the recursion anyway.
  "TCOMutRec.purs"
)

if [ -d "$HOME/.dotnet" ]; then
  export PATH="$HOME/.dotnet:$PATH"
fi
export PATH="$ROOT_DIR/node_modules/.bin:$PATH"

source "$ROOT_DIR/bin/pkg" || exit 1

for pkg in "${CORE_PACKAGES[@]}"; do
  if [ ! -d "$ROOT_DIR/../sharpurs-$pkg" ]; then
    echo -e "\033[0;31m[ERROR]\033[0m Missing sibling checkout: sharpurs-$pkg"
    echo "See README.md, Build the backend, for the checkout layout and clone command."
    exit 1
  fi
done

passed=0
failed=0

SKIP_BEFORE="" # Inclusive start, e.g. "TCO" or "TCO.purs".
UNTIL="" # E.g. "ExtendedInfixOperators" to stop after that test
TEST_FILES=()
CLEAN_CACHE=0

selection_error() {
  echo "Invalid fixture selection: $1" >&2
  exit 1
}

is_blacklisted() {
  local excluded
  for excluded in "${BLACKLIST[@]}"; do
    if [ "$1" = "$excluded" ]; then return 0; fi
  done
  return 1
}

if [ $# -gt 0 ]; then
  for arg in "$@"; do
    if [[ "$arg" == skip_before=* || "$arg" == --skip-before=* ]]; then
      SKIP_BEFORE="${arg#*=}"
      [ -n "$SKIP_BEFORE" ] || selection_error "--skip-before needs a fixture name."
    elif [[ "$arg" == until=* || "$arg" == --until=* ]]; then
      UNTIL="${arg#*=}"
      [ -n "$UNTIL" ] || selection_error "--until needs a fixture name."
    elif [[ "$arg" == "-c" || "$arg" == "--clean" ]]; then
      CLEAN_CACHE=1
    else
      if [ -f "$ROOT_DIR/$arg" ]; then
        TEST_FILES+=("$ROOT_DIR/$arg")
      elif [ -f "$arg" ]; then
        # Resolve caller-relative inputs before changing to the shared runner.
        fixture_dir=$(cd "$(dirname "$arg")" && pwd) || selection_error "Cannot resolve $arg."
        TEST_FILES+=("$fixture_dir/${arg##*/}")
      elif [ -f "$PASSING_DIR/$arg" ]; then
        TEST_FILES+=("$PASSING_DIR/$arg")
      elif [ -f "$PASSING_DIR/$arg.purs" ]; then
        TEST_FILES+=("$PASSING_DIR/$arg.purs")
      else
        echo "Test file $arg not found." >&2
        exit 1
      fi
    fi
  done
fi

# Resolve the range before creating, locking or cleaning the shared workspace.
# Keep Bash's glob order, or the caller's explicit file order.
if [ ${#TEST_FILES[@]} -eq 0 ]; then
  TEST_FILES=("$PASSING_DIR"/*.purs)
fi
for test_file in "${TEST_FILES[@]}"; do
  [ -f "$test_file" ] || selection_error "No fixture found at $test_file."
done

bound_index() {
  local target="$1" option="$2" found=-1 index name
  for index in "${!TEST_FILES[@]}"; do
    name="${TEST_FILES[$index]##*/}"
    if [[ "$name" == "$target" || "$name" == "$target.purs" ]]; then
      [ "$found" -eq -1 ] || selection_error "$option target '$target' is ambiguous in the selected fixtures."
      found=$index
    fi
  done
  [ "$found" -ne -1 ] || selection_error "$option target '$target' is not in the selected fixtures."
  echo "$found"
}

start_index=0
end_index=$((${#TEST_FILES[@]} - 1))
if [ -n "$SKIP_BEFORE" ]; then
  start_index=$(bound_index "$SKIP_BEFORE" --skip-before) || exit 1
fi
if [ -n "$UNTIL" ]; then
  end_index=$(bound_index "$UNTIL" --until) || exit 1
fi
[ "$start_index" -le "$end_index" ] || selection_error "--until precedes --skip-before in the selected fixture order."
TEST_FILES=("${TEST_FILES[@]:$start_index:$((end_index - start_index + 1))}")
runnable=0
for test_file in "${TEST_FILES[@]}"; do
  if ! is_blacklisted "${test_file##*/}"; then runnable=$((runnable + 1)); fi
done
[ "$runnable" -gt 0 ] || selection_error "The selected range contains no runnable fixtures (all are blacklisted)."

LOCK_DIR="$RUNNER_DIR/.sharpurs-test.lock"
LOCK_OWNED=0
CACHE_SNAPSHOT=""
CACHE_READY=0
RUN_STARTED=0

runner_error() {
  printf '   [FAILED] %s\n' "$1" >&2
  return 1
}

# Callers explicitly stop after errors, including when a function is used in an
# if/|| condition. Do not rely on Bash's context-dependent errexit behavior.
runner_io() {
  local operation="$1" status
  shift
  if "$@"; then return 0; else status=$?; fi
  runner_error "$operation (exit $status)"
}

acquire_runner() {
  runner_io "Create runner $RUNNER_DIR" mkdir -p "$RUNNER_DIR" || return 1
  if ! mkdir "$LOCK_DIR"; then
    if [ -d "$LOCK_DIR" ]; then
      runner_error "Fixture runner is already in use: $LOCK_DIR"
    else
      runner_error "Create runner lock $LOCK_DIR"
    fi
    return 1
  fi
  LOCK_OWNED=1
  printf '%s\n' "$$" > "$LOCK_DIR/pid" || { runner_error "Write lock owner $LOCK_DIR/pid"; return 1; }
}

snapshot_cache() {
  CACHE_SNAPSHOT=$(mktemp -d "${TMPDIR:-/tmp}/sharpurs-runner-cache.XXXXXX") || {
    runner_error "Create runner cache snapshot"; return 1;
  }
  if [ -d "$RUNNER_DIR/.purmeta" ]; then
    runner_io "Save cache $RUNNER_DIR/.purmeta" cp -pR "$RUNNER_DIR/.purmeta" "$CACHE_SNAPSHOT/.purmeta" || return 1
  elif [ -e "$RUNNER_DIR/.purmeta" ] || [ -L "$RUNNER_DIR/.purmeta" ]; then
    runner_error "Expected a cache directory at $RUNNER_DIR/.purmeta"
    return 1
  fi
  # An incomplete snapshot must never replace the untouched original cache.
  CACHE_READY=1
}

restore_cache() {
  # Stop before copying if removal fails: cp would otherwise nest .purmeta
  # inside the failed destination and leave the mutated cache in place.
  runner_io "Remove invocation cache $RUNNER_DIR/.purmeta" rm -rf "$RUNNER_DIR/.purmeta" || return 1
  if [ -d "$CACHE_SNAPSHOT/.purmeta" ]; then
    runner_io "Restore cache from $CACHE_SNAPSHOT/.purmeta" cp -pR "$CACHE_SNAPSHOT/.purmeta" "$RUNNER_DIR/.purmeta" || return 1
  fi
}

release_runner() {
  local status=0 keep_snapshot=0
  if [ "$CACHE_READY" -eq 1 ] && ! restore_cache; then
    echo "Cache restoration failed; saved copy: $CACHE_SNAPSHOT" >&2
    keep_snapshot=1
    status=1
  fi
  if [ -n "$CACHE_SNAPSHOT" ] && [ "$keep_snapshot" -eq 0 ]; then
    runner_io "Remove cache snapshot $CACHE_SNAPSHOT" rm -rf "$CACHE_SNAPSHOT" || status=1
  fi
  if [ "$LOCK_OWNED" -eq 1 ]; then
    runner_io "Release runner lock $LOCK_DIR" rm -rf "$LOCK_DIR" || status=1
  fi
  return "$status"
}

finish_runner() {
  local status="$1"
  trap - EXIT
  # Complete restoration once, including after a handled interruption.
  trap '' INT TERM
  release_runner || status=1
  if [ "$RUN_STARTED" -eq 1 ]; then
    echo ""
    if [ "$status" -eq 0 ]; then
      echo -e "Summary: \033[0;32m$passed passed\033[0m, 0 failed."
    elif [ "$failed" -gt 0 ]; then
      echo -e "Summary: \033[0;32m$passed passed\033[0m, \033[0;31m$failed failed\033[0m."
    else
      echo "Summary: $passed passed; runner failed (exit $status)." >&2
    fi
  fi
  exit "$status"
}

write_config() {
  local pkg
  local lines=("package:" "  name: runner" "  dependencies:")
  for pkg in "${CORE_PACKAGES[@]}"; do
    lines+=("    - $pkg")
  done
  lines+=("workspace:" "  packageSet:" "    registry: 77.10.1" "  extraPackages:")
  for pkg in "${CORE_PACKAGES[@]}"; do
    lines+=("    $pkg:" "      path: \"../../../sharpurs-$pkg\"")
  done
  printf '%s\n' "${lines[@]}"
}

prepare_workspace() {
  runner_io "Create fixture source directory $RUNNER_DIR/src" mkdir -p "$RUNNER_DIR/src" || return 1
  runner_io "Enter runner $RUNNER_DIR" cd "$RUNNER_DIR" || return 1
  if [ ! -f spago.yaml ]; then
    if [ -e spago.yaml ] || [ -L spago.yaml ]; then
      runner_error "Expected a configuration file at $RUNNER_DIR/spago.yaml"
      return 1
    fi
    write_config > "$LOCK_DIR/spago.yaml" || { runner_error "Write runner configuration $LOCK_DIR/spago.yaml"; return 1; }
    runner_io "Publish runner configuration $RUNNER_DIR/spago.yaml" mv "$LOCK_DIR/spago.yaml" "$RUNNER_DIR/spago.yaml" || return 1
  fi
}

prepare_fixture() {
  local test_file="$1" stale status sibling_js test_dir
  local companions=()
  runner_io "Clean previous fixture sources and build outputs" rm -rf src/* output/Test* output/Main/bin output/Main/obj || return 1
  # Drop modules compiled from a previous fixture's src (Main and companions).
  for stale in output/*/corefn.json; do
    [ -e "$stale" ] || [ -L "$stale" ] || continue
    if grep -q '"modulePath":"src/' "$stale"; then
      runner_io "Remove stale fixture module ${stale%/*}" rm -rf "${stale%/*}" || return 1
    else
      status=$?
      [ "$status" -eq 1 ] || { runner_error "Inspect fixture provenance $stale (exit $status)"; return 1; }
    fi
  done
  runner_io "Copy fixture $test_file" cp "$test_file" src/Main.purs || return 1
  # purs needs the JS implementation to typecheck a module with foreign imports.
  sibling_js="${test_file%.purs}.js"
  if [ -f "$sibling_js" ]; then
    runner_io "Copy fixture foreign implementation $sibling_js" cp "$sibling_js" src/Main.js || return 1
  fi
  test_dir="${test_file%.purs}"
  if [ -d "$test_dir" ]; then
    companions=("$test_dir"/*)
    if [ -e "${companions[0]}" ] || [ -L "${companions[0]}" ]; then
      runner_io "Copy fixture companions $test_dir" cp -r "${companions[@]}" src/ || return 1
    fi
  fi
}

run_fixture() {
  local test_file="$1" out backend_out output_run exit_code
  echo "=> Testing ${test_file##*/}"
  prepare_fixture "$test_file" || return 1

  # Each phase depends on the preceding phase's actual exit status.
  if ! out=$(spago build -q 2>&1); then
    runner_error "PureScript Compilation error"
    echo "$out"
    return 1
  fi
  if [ ! -f "$ROOT_DIR/bin/sharpurs.js" ]; then
    runner_error "bin/sharpurs.js is missing; build sharpurs first"
    return 1
  fi
  runner_io "Remove previous Main project" rm -f output/Main/Program.fsproj || return 1
  if ! backend_out=$("$ROOT_DIR/bin/sharpurs" --main Main 2>&1); then
    runner_error "sharpurs generation failed"
    echo "$backend_out"
    return 1
  fi
  if [ ! -f output/Main/Program.fsproj ]; then
    runner_error "sharpurs did not generate Main project"
    echo "$backend_out"
    return 1
  fi
  command -v dotnet >/dev/null 2>&1 || { runner_error "dotnet SDK not found. Please install it."; return 1; }
  output_run=$(dotnet run -c Release -v q --nologo --project output/Main/Program.fsproj 2>&1)
  exit_code=$?
  if [ -n "$output_run" ]; then echo "$output_run"; fi
  if [ "$exit_code" -ne 0 ] || [[ "$output_run" == *Fail* ]]; then
    runner_error "Execution error"
    return 1
  fi
  echo -e "   \033[0;32m[OK]\033[0m"
}

run_tests() {
  local test_file test_name
  acquire_runner || return 1
  snapshot_cache || return 1
  if [ "$CLEAN_CACHE" -eq 1 ]; then
    echo "Building sharpurs compiler..."
    runner_io "Enter compiler $ROOT_DIR" cd "$ROOT_DIR" || return 1
    node scripts/build.mjs || { runner_error "sharpurs build failed!"; return 1; }
  fi
  prepare_workspace || return 1
  echo "Running tests from $PASSING_DIR..."
  if [ "$CLEAN_CACHE" -eq 1 ]; then
    echo "=> Cleaning Spago and output cache..."
    runner_io "Clean Spago and output cache" rm -rf .spago/* output-es/* output/* || return 1
  fi
  RUN_STARTED=1
  for test_file in "${TEST_FILES[@]}"; do
    test_name="${test_file##*/}"
    if is_blacklisted "$test_name"; then
      echo "=> Skipping $test_name (blacklisted)"
      continue
    fi
    if run_fixture "$test_file"; then
      passed=$((passed + 1))
    else
      failed=$((failed + 1))
      return 1
    fi
  done
}

# The lock and a complete snapshot are tracked separately. Even failures while
# acquiring ownership or saving the cache reach this single finalization path.
trap 'finish_runner $?' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
run_tests
exit $?
